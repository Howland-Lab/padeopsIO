TI_xloc                       = {{ "%.4f"|format(TI_xloc|float)}}d0             ! Amplifier for HIT fluctuations. Set to > 0 to enable manually
freeze_HIT                    = .{{ freeze_hit }}.                              ! Freeze HIT targets? (e.g. for Mann turbulence)
